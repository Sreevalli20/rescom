# AI Voice Sales Agent Backend - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub

# Application
APP_NAME="AI Voice Sales Agent Backend"
APP_VERSION="1.0.0"
DEBUG=false

# CORS - Your frontend URL (e.g., Vercel deployment)
FRONTEND_URL=http://localhost:3000

# Database - PostgreSQL on Render
# For local development, SQLite will be used: sqlite:///./sales_agent.db
# For Render PostgreSQL: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/database

# Exotel Configuration
EXOTEL_ACCOUNT_SID=your_account_sid
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_PHONE_NUMBER=your_exotel_phone_number

# Twilio Configuration (for WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919876543210

# WhatsApp Provider
# Options: mock, twilio, messagebird, gupshup
WHATSAPP_PROVIDER=twilio

# Contact and Resume Information
CONTACT_MOBILE=+919876543210
RESUME_URL=https://your-resume-url.com/resume.pdf
ARCHITECTURE_IMAGE_URL=https://your-architecture-url.com/architecture.png

# AI/LLM Configuration (optional, for advanced conversation features)
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini

# Webhook Security
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

# Timezone
TIMEZONE=Asia/Kolkata
